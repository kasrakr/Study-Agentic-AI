# Copy to backend/.env and fill in. Never commit the real .env file.

# --- OpenAI (required) -------------------------------------------------------
# API key from https://platform.openai.com/api-keys (API billing is separate
# from a ChatGPT subscription).
OPENAI_API_KEY=
# Chat model used for every LLM operation. Check the OpenAI models page for
# models available to your account.
OPENAI_CHAT_MODEL=gpt-4o-mini
# Embedding model. Changing this later requires rebuilding the vector index
# (delete storage/vectorstore and re-upload documents).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2

# --- Tavily web search (used from Phase 4; separate key, optional for now) ---
TAVILY_API_KEY=

# --- Storage (relative paths resolve against the repository root) -----------
DATABASE_URL=sqlite:///storage/study.db
CHROMA_PERSIST_DIRECTORY=storage/vectorstore
UPLOAD_DIRECTORY=storage/uploads

# --- API / ingestion ---------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_SIZE_MB=25
MAX_DOCUMENT_PAGES=500
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=6
# Passages scoring below this cosine similarity are dropped (0 disables).
RETRIEVAL_MIN_SCORE=0.0
LOG_LEVEL=INFO
